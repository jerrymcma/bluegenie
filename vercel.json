{
  "buildCommand": "cd bluegenie-web && npm run build",
  "outputDirectory": "bluegenie-web/dist",
  "installCommand": "cd bluegenie-web && npm install",
  "functions": {
    "bluegenie-web/api/groq.js": {
      "maxDuration": 60
    },
    "bluegenie-web/api/music.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
