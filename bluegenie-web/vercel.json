{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/groq.js": {
      "maxDuration": 60
    },
    "api/music.js": {
      "maxDuration": 120
    }
  },
  "redirects": [
    {
      "source": "https://bluegeniemagic.com/:path*",
      "destination": "https://www.bluegeniemagic.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
